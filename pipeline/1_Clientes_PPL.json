{
	"name": "1_Clientes_PPL",
	"properties": {
		"activities": [
			{
				"name": "CopyClientesBronze",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "file_name",
								"value": "$$FILENAME"
							},
							{
								"name": "ingestion_ts",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AvroSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings",
							"copyBehavior": "MergeFiles"
						},
						"formatSettings": {
							"type": "AvroWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['tipo_cliente']"
								},
								"sink": {
									"name": "tipo_cliente",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['pais']"
								},
								"sink": {
									"name": "pais",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['file_name']"
								},
								"sink": {
									"name": "file_name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['ingestion_ts']"
								},
								"sink": {
									"name": "ingestion_ts",
									"type": "String"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "JsonBlobStorage",
						"type": "DatasetReference",
						"parameters": {
							"file_json": "clientes"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AvroBlobStorage",
						"type": "DatasetReference",
						"parameters": {
							"avro_name": "Clientes"
						}
					}
				]
			}
		],
		"folder": {
			"name": "Agricopel/GlobalSales"
		},
		"annotations": []
	}
}