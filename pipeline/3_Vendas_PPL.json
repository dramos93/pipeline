				},
				"inputs": [
					{
						"referenceName": "CSVBlobStorage",
						"type": "DatasetReference",
						"parameters": {
							"file_name": "vendas"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AvroBlobStorage",
						"type": "DatasetReference",
						"parameters": {
							"avro_name": "Vendas"
						}
					}
				]
			}
		],
		"folder": {
			"name": "Agricopel/GlobalSales"
		},
		"annotations": []
	}
